{
  "name": "pebble-prime",
  "private": true,
  "version": "3.0.0",
  "type": "module",
  "description": "PEBBLE: a stylebook of the sixteen things a Turnstone Pebble carries, set like a magazine cover. Fan-made, unofficial.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "textures": "node scripts/textures.mjs",
    "model": "node scripts/textures.mjs && /Applications/Blender.app/Contents/MacOS/Blender --background --factory-startup --python blender/build_pebble.py -- public/models/pebble.glb",
    "fonts": "node scripts/fonts.mjs",
    "meta": "node scripts/meta.mjs",
    "bench": "node scripts/bench.mjs sections desktop",
    "qa": "node scripts/qa.mjs check",
    "qa:3d": "node scripts/qa3d.mjs",
    "qa:sweep": "node scripts/qa.mjs sweep desktop"
  },
  "dependencies": {
    "@fontsource-variable/jost": "^5.3.0",
    "@fontsource/zen-kaku-gothic-new": "^5.3.0",
    "gsap": "^3.15.0",
    "smooth-scrollbar": "^8.8.4",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "playwright": "^1.63.0",
    "sharp": "^0.35.5",
    "three-mesh-bvh": "^0.9.16",
    "vite": "^8.3.3"
  }
}
